APP_NAME=SalesIA Enterprise API
API_PREFIX=/api/v1
# Usa la URI Session pooler (puerto 5432) de Supabase y reemplaza los marcadores.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:DATABASE_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
JWT_SECRET_KEY=replace_with_openssl_rand_hex_32_output
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=["http://localhost:5173"]
